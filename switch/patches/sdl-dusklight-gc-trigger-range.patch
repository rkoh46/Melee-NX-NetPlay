--- a/src/joystick/switch/SDL_sysjoystick.c
+++ b/src/joystick/switch/SDL_sysjoystick.c
@@ -219,6 +219,26 @@
 static bool SWITCH_JoystickSetSensorsEnabled(SDL_Joystick *joystick, bool enabled)
 {
     return SDL_Unsupported();
+}
+
+/* GameCube trigger range. Measured in replays: the system reports a GameCube trigger's analog
+ * travel as 0 .. about 0x1F00 (a full pull without the click read 0.23 of the axis unscaled, in
+ * steps of ~0xDA), and jumps to 0x7FFF only at the digital click. Scaled by 8, half a pull already
+ * saturated, so every light press was a full-strength shield; scaled by 4 the full travel reaches
+ * the top of a real controller's analog range (~248 of 255) and the game's own clamp (30..180)
+ * sees the whole light-shield range. The click saturates. The largest analog value seen without
+ * the click is kept per slot (melee_nx_gc_trigger_travel) so the app can log it. */
+int melee_nx_gc_trigger_travel[8];
+static int gc_trigger_axis(int slot, Uint32 pos)
+{
+    if ((int)pos < 0x7000 && slot >= 0 && slot < 8 && (int)pos > melee_nx_gc_trigger_travel[slot]) {
+        melee_nx_gc_trigger_travel[slot] = (int)pos;
+    }
+    int full = (int)pos * 4;
+    if (full > 32767) {
+        full = 32767;
+    }
+    return full * 2 - 32768;
 }
 
 static Sint16 clamp_axis(int v)
@@ -282,8 +302,8 @@
      * axes from the L/R buttons would turn GC Z into a shoulder pull; without the GC
      * style the axes stay released and the buttons carry the mapping (misc3/misc4). */
     const bool has_gc_triggers = (padGetStyleSet(pad) & HidNpadStyleTag_NpadGc) != 0;
-    const int trigger_l = has_gc_triggers ? ((int)padGetGcTriggerPos(pad, 0) * 2 - 32768) : -32768;
-    const int trigger_r = has_gc_triggers ? ((int)padGetGcTriggerPos(pad, 1) * 2 - 32768) : -32768;
+    const int trigger_l = has_gc_triggers ? gc_trigger_axis(slot, padGetGcTriggerPos(pad, 0)) : -32768;
+    const int trigger_r = has_gc_triggers ? gc_trigger_axis(slot, padGetGcTriggerPos(pad, 1)) : -32768;
     SDL_SendJoystickAxis(timestamp, joystick, 4, clamp_axis(trigger_l));
     SDL_SendJoystickAxis(timestamp, joystick, 5, clamp_axis(trigger_r));
 }
