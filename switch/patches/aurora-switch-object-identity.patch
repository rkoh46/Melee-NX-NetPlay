+// A host that keeps texture and palette bytes in its own short-lived buffers cannot rely on the
+// pointer-derived identities above: a freed buffer's address is reused by different content
+// within the object caches' lifetime, and the stale conversion is served. Such a host sets an
+// identity from the content instead (any hash; version distinguishes revisions).
+void __GXSetTexObjIdentity(GXTexObj* obj_, u32 id, u32 version) {
+  auto* obj = reinterpret_cast<GXTexObj_*>(obj_);
+  obj->texObjId = id ? id : 1;
+  obj->texDataVersion = version;
+}
+void __GXSetTlutObjIdentity(GXTlutObj* obj_, u32 id, u32 version) {
+  auto* obj = reinterpret_cast<GXTlutObj_*>(obj_);
+  obj->tlutObjId = id ? id : 1;
+  obj->tlutDataVersion = version;
+}
+
 void GXInitTlutObjData(GXTlutObj* obj_, const void* data) {
   auto* obj = reinterpret_cast<GXTlutObj_*>(obj_);
   obj->data = data;
