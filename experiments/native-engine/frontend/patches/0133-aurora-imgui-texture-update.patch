+// Melee-NX-NetPlay frontend/patches/0133: new pixels for a texture add_texture made, at the same size (a video drawn by ImGui:
+// the border art's video). False when the texture is not one of these or its size differs.
+bool update_texture(ImTextureID id, uint32_t width, uint32_t height, const uint8_t* data) noexcept {
+  if (SDL_Renderer* renderer = window::get_sdl_renderer()) {
+    for (SDL_Texture* texture : g_sdlTextures)
+      if (reinterpret_cast<ImTextureID>(texture) == id) return SDL_UpdateTexture(texture, nullptr, data, int(width * 4));
+    return false;
+  }
+  for (size_t i = 0; i < g_wgpuTextureViews.size(); ++i) {
+    if (reinterpret_cast<ImTextureID>(g_wgpuTextureViews[i]) != id) continue;
+    const wgpu::Texture& texture = g_wgpuTextures[i];
+    if (texture.GetWidth() != width || texture.GetHeight() != height) return false;
+    const wgpu::TexelCopyTextureInfo dstView{.texture = texture};
+    const uint32_t copyBytesPerRow = AURORA_ALIGN(width * 4, 256);
+    const wgpu::TexelCopyBufferLayout dataLayout{.bytesPerRow = copyBytesPerRow, .rowsPerImage = height};
+    const wgpu::Extent3D size{.width = width, .height = height, .depthOrArrayLayers = 1};
+    enqueue_texture_upload(create_texture_upload_buffer(width, height, data, copyBytesPerRow), dstView, dataLayout, size);
+    return true;
+  }
+  return false;
+}
