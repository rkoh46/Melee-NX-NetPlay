+  bool lab_cover = false;   // patches/0129: the Lab view covers the match (labskipscene): the world's draws are not handed to Aurora
 };
 inline uint8_t stage_map(const DrawCall& d) { return uint8_t(d.viewport_x); }   // patches/0116 decoder: the 0xF7 tag
