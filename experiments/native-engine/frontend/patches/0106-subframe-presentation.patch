 // Exact geometry is the reuse gate. A stable draw address/ordinal does not prove
 // that regenerated vertices describe the same surface. Ignore only padding and
 // attributes absent from the captured layout; compare every active input.
+// A vertex's matrix selectors: from the decoded stream, or (patches/0106 of the native-engine frontend) from a
+// raw-captured one, where the GX direct format puts PNMTXIDX (VCD_LO bit 0) and then TEX0..7MTXIDX (bits 1..8),
+// one byte each, at the start of every vertex. 64: none.
+uint32_t vertex_posmtx(const Frame& f, const DrawCall& d, uint32_t v) {
+  if (!d.raw_size) return f.vertices[d.first_vertex + v].posmtx;
+  if (!(d.vcd_lo & 1) || !d.vertex_count || d.raw_size % d.vertex_count) return 64;
+  const size_t at = size_t(d.raw_offset) + size_t(v) * (d.raw_size / d.vertex_count);
+  return at < f.raw_vertices.size() ? f.raw_vertices[at] : 64;
+}
+uint32_t vertex_texmtx(const Frame& f, const DrawCall& d, uint32_t v, uint32_t k) {
+  if (!d.raw_size) return f.vertices[d.first_vertex + v].texmtx[k];
+  if (!((d.vcd_lo >> (1 + k)) & 1) || !d.vertex_count || d.raw_size % d.vertex_count) return 64;
+  uint32_t offset = d.vcd_lo & 1;
+  for (uint32_t j = 0; j < k; ++j) offset += (d.vcd_lo >> (1 + j)) & 1;
+  const size_t at = size_t(d.raw_offset) + size_t(v) * (d.raw_size / d.vertex_count) + offset;
+  return at < f.raw_vertices.size() ? f.raw_vertices[at] : 64;
+}
