+// Screen-space ambient occlusion (after melee-unlocked's present_shader.h ao(), GPL-2.0-or-later): contact edges darken where
+// a neighbour two console pixels away is nearer than this pixel. Aurora's depth is reversed (cleared to 0, nearer is larger)
+// and close to 1/distance, so the test is relative (a neighbour 3% nearer) where upstream's has an absolute floor that
+// Aurora's small values never pass; cleared pixels (the sky) are left alone.
+fn ambient_occlusion(uv: vec2<f32>) -> f32 {
+    if (uniforms.ssao <= 0.0) {
+        return 1.0;
+    }
+    let dims = vec2<i32>(textureDimensions(depth_t));
+    let hi = dims - vec2<i32>(1, 1);
+    let centre = clamp(vec2<i32>(uv * vec2<f32>(dims)), vec2<i32>(0, 0), hi);
+    let d = textureLoad(depth_t, centre, 0);
+    if (d <= 0.00001) {
+        return 1.0;
+    }
+    let reach = max(2, (2 * dims.y + 240) / 480);
+    let bias = d * 0.03;
+    var occ = 0.0;
+    for (var k = 0; k < 9; k = k + 1) {
+        if (k == 4) {
+            continue;
+        }
+        let offset = vec2<i32>(k % 3 - 1, k / 3 - 1) * reach;
+        let nd = textureLoad(depth_t, clamp(centre + offset, vec2<i32>(0, 0), hi), 0);
+        occ = occ + select(0.0, 1.0, nd > d + bias);
+    }
+    return clamp(1.0 - occ * 0.125 * uniforms.ssao, 0.0, 1.0);
+}
