+  // patches/0130: looping menu video backgrounds (src/video_bg.cpp). The video's newest frame as a texture of the renderer's own,
+  // re-uploaded when the decoder has a new one (its serial is the object's version).
+  TextureObject video_texture;
+  uint64_t video_serial = 0;
+  TextureObject& video_object(const fe::video_bg::Frame& f) {
+    if (f.serial != video_serial || video_texture.converted.size() != f.rgba.size()) {
+      video_serial = f.serial;
+      video_texture.converted = f.rgba;
+      GXInitTexObj(&video_texture.texture, video_texture.converted.data(), uint16_t(f.width), uint16_t(f.height), GX_TF_RGBA8_PC, GX_CLAMP, GX_CLAMP, GX_FALSE);
+      GXInitTexObjLOD(&video_texture.texture, GX_LINEAR, GX_LINEAR, 0.f, 0.f, 0.f, GX_FALSE, GX_FALSE, GX_ANISO_1);
+      GXInitTexObjNoCache(&video_texture.texture, GX_TRUE);   // a new picture in the same buffer: never served from the content cache
+      __GXSetTexObjIdentity(&video_texture.texture, 0x7E000000u ^ uint32_t(f.serial & 0xFFFFFF), uint32_t(f.serial));
+    }
+    video_texture.last_frame = counters.frames;
+    return video_texture;
+  }
