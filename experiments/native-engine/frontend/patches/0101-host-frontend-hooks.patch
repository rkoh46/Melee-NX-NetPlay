+// The frontend's view of the disc table: find a file (lower-case path with a leading slash; -1 none, -2 a
+// directory), replace or add one, read the retail disc.
+int32_t fe_disc_find(const char* path, uint32_t* start, uint32_t* length) {
+  const auto at = paths.find(path);
+  if (at == paths.end()) return -1;
+  if (files[at->second].directory) return -2;
+  if (start) *start = files[at->second].start;
+  if (length) *length = files[at->second].length;
+  return at->second;
+}
+int32_t fe_disc_set(const char* path, uint32_t start, uint32_t length) {
+  const auto at = paths.find(path);
+  if (at != paths.end()) { if (files[at->second].directory) return -2; files[at->second] = {start, length, false}; return at->second; }
+  files.push_back({start, length, false});
+  paths[path] = int32_t(files.size() - 1);
+  return int32_t(files.size() - 1);
+}
+void fe_disc_remove(const char* path) { paths.erase(path); }
+bool fe_disc_read_base(uint32_t offset, void* out, uint32_t bytes) {
+  if (disc_fd < 0 || offset > disc_size || bytes > disc_size - offset) return false;
+  size_t done = 0;
+  while (done < bytes) {
+    const ssize_t n = pread(disc_fd, static_cast<uint8_t*>(out) + done, bytes - done, static_cast<off_t>(offset + done));
+    if (n < 0 && errno == EINTR) continue;
+    if (n <= 0) return false;
+    done += size_t(n);
+  }
+  return true;
+}
