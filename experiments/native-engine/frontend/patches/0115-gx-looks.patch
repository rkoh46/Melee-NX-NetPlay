+inline uint8_t stage_map(const DrawCall& d) { return uint8_t(d.viewport_x); }   // patches/0115 decoder: the 0xF7 tag
+inline bool world(const Filter& e, const DrawState& st) {
+  return e.in_match && st.xf_regs[0x26] == 0 && std::memcmp(e.projection, &st.xf_regs[0x20], sizeof e.projection) == 0;
