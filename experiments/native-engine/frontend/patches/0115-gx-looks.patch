+// ---------------- looks (frontend/patches/0115, frontend/src/looks_live.h) ----------------
+// melee-unlocked's look rules (gx_core.h lightweight_* and skip_for_effects, gx_retro.h look_surface, gx_shader.cpp's
+// look tints), applied here to each draw before Aurora sees it. Display only.
+namespace look {
+using fe::looks::Surface;
+constexpr uint8_t kEffectOwner = 0xFE, kModelEffectOwner = 0xFC, kGameplayOwner = 0xFD;
+constexpr float kBackgroundDepth = 60.0f;
+struct Filter {
+  bool on = false, in_match = false, have_fighters = false, backdrop_off = false;
+  int level = 0, effects = 0;
+  uint32_t projection[6] = {};
+  float fighter_far = 0;
+  uint8_t fighter = 0, stage = 0, menus = 0, colours = 0;
+  bool unfiltered = false;
