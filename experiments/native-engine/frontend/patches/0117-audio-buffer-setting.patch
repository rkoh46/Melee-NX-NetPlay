+// The ring's slack on top of the device buffer, now and at the next open (melee-unlocked's Auto and Low latency buffer).
+void audio_set_buffer_ms(int ms) {
+  ms = std::clamp(ms, 4, 200);
+  g_requested_ms.store(ms);
+  std::lock_guard<std::mutex> lock(g_mutex);
+  if (g_stream) g_target_frames = std::min<size_t>(g_device_part + size_t(SAMPLE_RATE) * ms / 1000, RING_FRAMES / 2);
+}
+int audio_buffer_ms() { return g_requested_ms.load() >= 0 ? g_requested_ms.load() : ring_slack_ms(); }
 void audio_set_speed(double speed) { g_speed.store(std::clamp(speed, 0.5, 2.0), std::memory_order_relaxed); }
 void audio_rate_range(double* low, double* high) { if (low) *low = g_rate_min.load(); if (high) *high = g_rate_max.load(); }
 uint32_t audio_buffered_ms() { return uint32_t((g_ring_write.load() - g_ring_read.load()) * 1000 / SAMPLE_RATE); }
