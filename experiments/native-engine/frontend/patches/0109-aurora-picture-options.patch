+// The home television's glass: the picture's coordinates bent outwards; `face` is 0 outside the tube.
+fn crt_curve(uv: vec2<f32>, curve: f32, face: ptr<function, f32>) -> vec2<f32> {
+    var q = uv * 2.0 - vec2<f32>(1.0);
+    q = q * (vec2<f32>(1.0) + curve * vec2<f32>(q.y * q.y, q.x * q.x));
+    q = q / (1.0 + curve * 0.5);
+    let px = 4.0 / max(vec2<f32>(uniforms.frame_width, uniforms.frame_height), vec2<f32>(1.0));
+    let edge = smoothstep(vec2<f32>(0.0), vec2<f32>(1.0), (vec2<f32>(1.0) - abs(q)) / px);
+    let corner = max(abs(q) - vec2<f32>(1.0 - 0.045), vec2<f32>(0.0)) / 0.045;
+    *face = edge.x * edge.y * clamp((1.0 - length(corner)) / (max(px.x, px.y) / 0.045), 0.0, 1.0);
+    *face = *face * (1.0 - 0.35 * curve * dot(q, q) * 0.5);
+    return q * 0.5 + vec2<f32>(0.5);
