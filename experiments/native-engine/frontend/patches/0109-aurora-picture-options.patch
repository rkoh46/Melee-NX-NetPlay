+// Contrast-adaptive sharpening on the source's own texels: the cross of neighbours around the sample sets how far
+// the centre may be pushed, so flat areas and hard edges are left alone and soft detail gains contrast.
+fn sharpen(uv: vec2<f32>, centre: vec3<f32>, amount: f32) -> vec3<f32> {
+    let texel = 1.0 / vec2<f32>(textureDimensions(t));
+    let n = textureSampleLevel(t, s, uv + vec2<f32>(0.0, -texel.y), 0.0).rgb;
+    let so = textureSampleLevel(t, s, uv + vec2<f32>(0.0, texel.y), 0.0).rgb;
+    let w = textureSampleLevel(t, s, uv + vec2<f32>(-texel.x, 0.0), 0.0).rgb;
+    let e = textureSampleLevel(t, s, uv + vec2<f32>(texel.x, 0.0), 0.0).rgb;
+    let lo = min(centre, min(min(n, so), min(w, e)));
+    let hi = max(centre, max(max(n, so), max(w, e)));
+    let room = clamp(min(lo, vec3<f32>(1.0) - hi) / max(hi, vec3<f32>(0.0001)), vec3<f32>(0.0), vec3<f32>(1.0));
+    let weight = -sqrt(room) * mix(0.125, 0.2, amount);
+    let sharpened = (centre + (n + so + w + e) * weight) / (1.0 + 4.0 * weight);
+    return clamp(sharpened, vec3<f32>(0.0), vec3<f32>(1.0));
+}
