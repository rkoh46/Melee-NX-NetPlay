+#if defined(MU_PROAI_FRONTEND)
+// The base policies (each pro's imitation policy, the ones upstream ships in its zip): downloaded when the player says.
+StrongerStatus base_status() {
+  std::lock_guard<std::mutex> catalog_lock(g_mutex);
+  read_catalog();
+  StrongerStatus s;
+  for (const Entry& e : g_catalog) {
+    if (e.kind != "imitation") continue;
+    bool offered = false;
+    for (unsigned pro = 0; pro < kPros; ++pro) offered |= e.name[pro] >= 0;
+    if (!offered) continue;
+    ++s.total;
+    if (!present(e)) { ++s.missing; s.missing_mb += e.size ? e.size / 1e6 : 21.0; }
+  }
+  std::lock_guard<std::mutex> lk(g_fetch_mutex);
+  s.downloading = g_fetching.load();
+  return s;
+}
+void download_base() {
+  std::lock_guard<std::mutex> catalog_lock(g_mutex);
+  read_catalog();
+  for (const Entry& e : g_catalog)
+    if (e.kind == "imitation" && !present(e)) fetch_later(e, true);
+}
+// The catalog again (after the app wrote it, or a manual copy): read at the next question.
+void catalog_changed() {
+  std::lock_guard<std::mutex> catalog_lock(g_mutex);
+  g_catalog.clear();
+  g_catalog_state = 0;
+}
+#endif
