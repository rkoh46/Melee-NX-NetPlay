+// patches/0124: a texture dump, as Dolphin writes them (RGBA8 PNG), so a dump can become a Dolphin-format texture pack.
+bool write_png_rgba8(const std::filesystem::path& path, uint32_t width, uint32_t height, ArrayRef<uint8_t> rgba) noexcept {
+  if (width == 0 || height == 0 || rgba.size() < size_t(width) * height * 4) {
+    return false;
+  }
+  FILE* file = std::fopen(io::fs_path_to_string(path).c_str(), "wb");
+  if (!file) {
+    return false;
+  }
+  png_structp png = png_create_write_struct(PNG_LIBPNG_VER_STRING, nullptr, nullptr, nullptr);
+  png_infop info = png ? png_create_info_struct(png) : nullptr;
+  if (!png || !info) {
+    png_destroy_write_struct(&png, info ? &info : nullptr);
+    std::fclose(file);
+    return false;
+  }
+  std::vector<png_bytep> rows(height);
+  for (uint32_t y = 0; y < height; ++y) {
+    rows[y] = const_cast<png_bytep>(rgba.data() + size_t(y) * width * 4);
+  }
+  if (setjmp(png_jmpbuf(png))) {
+    png_destroy_write_struct(&png, &info);
+    std::fclose(file);
+    return false;
+  }
+  png_init_io(png, file);
+  png_set_compression_level(png, 1);
+  png_set_IHDR(png, info, width, height, 8, PNG_COLOR_TYPE_RGBA, PNG_INTERLACE_NONE, PNG_COMPRESSION_TYPE_DEFAULT,
+               PNG_FILTER_TYPE_DEFAULT);
+  png_write_info(png, info);
+  png_write_image(png, rows.data());
+  png_write_end(png, nullptr);
+  png_destroy_write_struct(&png, &info);
+  return std::fclose(file) == 0;
 }
 }
