+// patches/0124: the host's texture pack controls.
+void set_texture_dumps(bool on, const std::filesystem::path& directory) {
+  std::lock_guard lk(s_registryMutex);
+  s_dumpDirectory = on ? directory : std::filesystem::path{};
+  if (on && !directory.empty()) {
+    std::error_code ec;
+    std::filesystem::create_directories(directory, ec);
+  }
+  g_config.allowTextureDumps = on;
+  s_reportedMisses.clear();
+}
+uint64_t dumped_texture_count() { return s_dumpedCount.load(std::memory_order_relaxed); }
+void set_replacement_cache_budget(uint64_t bytes) {
+  s_cacheBudgetBytes.store(bytes ? bytes : kReplacementCacheBudgetBytes, std::memory_order_relaxed);
+}
+void reload_textures() {
+  gx::clear_static_texture_cache();
+  gx::texture::invalidate_bindings();
+}
+size_t registered_replacement_count() {
+  std::lock_guard lk(s_registryMutex);
+  return s_sourceEntryCount;
+}
+std::string replacement_file_name(const GXTexObj* obj, const GXTlutObj* tlut) {
+  const auto* obj_ = reinterpret_cast<const GXTexObj_*>(obj);
+  const auto key = tlut != nullptr ? build_source_key(*obj_, *reinterpret_cast<const GXTlutObj_*>(tlut)) : build_source_key(*obj_);
+  auto name = format_replacement_filename(key);
+  name.replace(name.size() - 4, 4, ".png");
+  return name;
+}
+void count_host_dump() { s_dumpedCount.fetch_add(1, std::memory_order_relaxed); }
+bool alias_pointer(const void* pointer, const GXTexObj* obj, const GXTlutObj* tlut) {
+  const auto* obj_ = reinterpret_cast<const GXTexObj_*>(obj);
+  const auto key = tlut != nullptr ? build_source_key(*obj_, *reinterpret_cast<const GXTlutObj_*>(tlut)) : build_source_key(*obj_);
+  std::lock_guard lk(s_registryMutex);
+  if (pointer == nullptr || s_sourceEntryCount == 0 || !find_source_replacement_key_locked(key).has_value()) {
+    return false;
+  }
+  s_pointerAliases[pointer] = key;
+  return true;
+}
+void remove_pointer_alias(const void* pointer) {
+  std::lock_guard lk(s_registryMutex);
+  s_pointerAliases.erase(pointer);
+}
