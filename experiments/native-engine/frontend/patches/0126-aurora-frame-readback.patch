+typedef void (*AuroraReadbackCallback)(void* user, uint64_t frame, uint32_t width, uint32_t height, const uint8_t* rgba);
+void aurora_set_frame_readback(uint32_t channel, uint32_t width, uint32_t height, AuroraReadbackCallback callback, void* user);
