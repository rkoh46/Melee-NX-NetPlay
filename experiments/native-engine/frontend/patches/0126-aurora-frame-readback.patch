+void aurora_set_frame_readback(uint32_t channel, uint32_t width, uint32_t height, AuroraReadbackCallback callback,
+                               void* user) {
+#ifdef AURORA_ENABLE_GX
+  if (channel >= AURORA_READBACK_CHANNELS) {
+    return;
+  }
+  std::lock_guard lock{aurora::g_readbackMutex};
+  auto& c = aurora::g_readbackChannels[channel];
+  c.width = width;
+  c.height = height;
+  c.callback = callback;
+  c.user = user;
+  if (!callback) {
+    c.target = {};
+  }
+#else
+  (void)channel; (void)width; (void)height; (void)callback; (void)user;
+#endif
+}
+uint64_t aurora_frame_readback_dropped() {
+#ifdef AURORA_ENABLE_GX
+  std::lock_guard lock{aurora::g_readbackMutex};
+  return aurora::g_readbackDropped;
+#else
+  return 0;
 #endif
