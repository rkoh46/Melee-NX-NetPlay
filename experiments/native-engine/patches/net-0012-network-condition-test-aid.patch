+// patches/net-0012, tests only (melee-unlocked's network condition simulator, hle/slippi_net.cpp): MELEE_NET_LOSS_PCT=P drops P %
+// of the datagrams that arrive (before ENet reads them, so reliable data is sent again as on a real lossy link);
+// MELEE_NET_LAG_MS=N and MELEE_NET_JITTER_MS=J hold every received match packet N + 0..J ms before it is handled, never
+// overtaking the one before it. Unset, as they always are for a player, nothing changes.
+static uint32_t test_loss_pct() {
+  static const uint32_t pct = [] {
+    const char* s = std::getenv("MELEE_NET_LOSS_PCT");
+    const long v = s ? std::atol(s) : 0;
+    if (v > 0 && v < 100) host::log("slippi: MELEE_NET_LOSS_PCT: dropping %ld%% of received datagrams (testing)", v);
+    return v > 0 && v < 100 ? (uint32_t)v : 0u;
+  }();
+  return pct;
+}
+static bool test_drop_datagram() {
+  if (!test_loss_pct()) return false;
+  static thread_local uint64_t state = 0x2545F4914F6CDD1Dull ^ (uint64_t)time_us();
+  state ^= state << 13; state ^= state >> 7; state ^= state << 17;
+  return (state % 100) < test_loss_pct();
 }
 static int ENET_CALLBACK intercept_callback(ENetHost* host, ENetEvent* event) {
   if (host->receivedDataLength == 1 && host->receivedData[0] == 0) { event->type = (ENetEventType)42; return 1; }
+  if (test_drop_datagram()) return 1;   // patches/net-0012: taken (dropped)
   note_incoming_connect(host);
   static const bool drop_connects = std::getenv("MELEE_NET_DROP_CONNECT") != nullptr;
   return drop_connects ? drop_connect_callback(host, event) : 0;
