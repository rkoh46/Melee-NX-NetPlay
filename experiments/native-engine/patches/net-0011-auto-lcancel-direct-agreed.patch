+// patches/net-0011: Auto L-cancel in Direct only when every player offered it (each side decides from the same exchanged bytes).
+bool NetplayClient::AutoLcancelAgreed() const {
+  std::lock_guard<std::mutex> lk(nx_mutex_);
+  if (remote_player_count_ == 0 || !sent_auto_lcancel_) return false;
+  int seen = 0;
+  for (int port = 0; port < 4; ++port) {
+    if (port == player_idx_) continue;
+    if (!remote_nx_[port].received) continue;          // not a player of this match, or no message (counted below)
+    if (!remote_nx_[port].auto_lcancel) return false;
+    ++seen;
+  }
+  return seen == remote_player_count_;               // a remote player without the message (Slippi Dolphin): no
+}
