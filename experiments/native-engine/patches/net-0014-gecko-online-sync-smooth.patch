+// patches/net-0014: Gecko codes online between Melee-NX-NetPlay builds.
+bool NetplayClient::GeckoPeer() const {
+  std::lock_guard<std::mutex> lk(nx_mutex_);
+  if (!sent_gecko_ || remote_player_count_ != 1) return false;
+  for (int port = 0; port < 4; ++port) if (port != player_idx_ && remote_nx_[port].received) return remote_nx_[port].gecko;
+  return false;
+}
+bool NetplayClient::SendNxGecko(const std::vector<uint8_t>& message) {
+  if (!GeckoPeer() || message.empty()) return false;
+  auto p = std::make_unique<Packet>();
+  *p << (uint8_t)NP_MSG_NX_GECKO;
+  for (uint8_t b : message) *p << b;
+  SendAsync(std::move(p));
+  return true;
+}
+bool NetplayClient::PopNxGecko(std::vector<uint8_t>& out) {
+  std::lock_guard<std::mutex> lk(nx_mutex_);
+  if (nx_gecko_inbox_.empty()) return false;
+  out = std::move(nx_gecko_inbox_.front());
+  nx_gecko_inbox_.pop_front();
+  return true;
+}
+void NetplayClient::SendNxGeckoLock() {
+  if (!mu_net_gecko_lock || !GeckoPeer()) return;
+  uint8_t lock[64];
+  const size_t n = mu_net_gecko_lock(lock, sizeof lock);
+  if (n > 0 && n <= sizeof lock) SendNxGecko(std::vector<uint8_t>(lock, lock + n));
+}
+void NetplayClient::ResendSelections() {
