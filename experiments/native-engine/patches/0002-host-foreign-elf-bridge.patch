+// Paced runs: how long the host has slept so far, so a frame's work can be told from its wait.
+uint64_t slept_nanoseconds() { return slept_ns; }
+// Experiment: the game waits for the next frame by polling, and every poll moves the console clock
+// by this many ticks (2048 in melee-unlocked, about 330 polls per frame).
+void set_poll_ticks(uint64_t ticks) { if (ticks) poll_ticks = ticks; }
+// Profiling: lets the runner see both interface tables, the host's before the game is given it and
+// the game's once it is filled in, so it can put timing wrappers around every entry.
+void set_tables_hook(void (*hook)(MuHostApi*, MuGameApi*)) { tables_hook = hook; }
+// Rollback test: after the game state has been put back `frames` frames, put the console clock back
+// with it, so the frames that are simulated again see the times they saw the first time.
+void rewind_frames(uint32_t frames) {
+  const uint64_t back = uint64_t(frames) * ticks_per_frame;
+  if (count.ticks < back || next_retrace < back) return;
+  count.ticks -= back; next_retrace -= back;
+}
