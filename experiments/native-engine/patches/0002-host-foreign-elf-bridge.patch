+#ifdef MU_FOREIGN_ELF
+// Rollback test: the game's engine loop asks console_origin(8) after each frame's simulation whether
+// to skip drawing it. A real rollback simulates its repeated frames without drawing; this lets the
+// test's repeated frames do the same. Every other query answers 0, as a host without the hook does.
