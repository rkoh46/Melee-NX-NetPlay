diff --git a/sourceport/tools/check_game_image.py b/sourceport/tools/check_game_image.py
index 432db5d..893fb3c 100644
--- a/sourceport/tools/check_game_image.py
+++ b/sourceport/tools/check_game_image.py
@@ -10,8 +10,8 @@ def image_range(data: bytes) -> tuple[int, int]:
         if data[4:6] != b'\x02\x01':
             raise ValueError('the native game must be a little-endian ELF64 library')
         header = struct.unpack_from('<16sHHIQQQIHHHHHH', data)
-        if header[1:3] != (3, 62):
-            raise ValueError('the native game must be an x86-64 ELF shared object')
