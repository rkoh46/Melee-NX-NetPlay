+// Online time sync: the frame rate against real time (1.0 normal), applied from the next paced frame on.
+void set_pace_speed(double speed) { pace_speed.store(speed < 0.5 ? 0.5 : speed > 2.0 ? 2.0 : speed, std::memory_order_relaxed); }
+double pace_speed_now() { return pace_speed_applied; }
 // Experiment: the game waits for the next frame by polling, and every poll moves the console clock
