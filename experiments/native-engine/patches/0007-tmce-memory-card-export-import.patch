 #define stc_memcard_unk ((MemcardUnk *)((char *)mu_tmce_ref_stc_memcard_unk + 0))
 // static MemcardWork *stc_memcard_work = (void *)0x80432a68;
+#ifdef MU_NATIVE
+/* Melee-NX-NetPlay (patches/0007): natively the game's card work block (lbcardnew.c `state`) has another layout than
+ * this console-layout struct, so TM-CE's is_done (0x8ac on the console, the game's task counter) was neither the field
+ * the card callback changes nor a field of TM-CE's own. TM-CE gets a block of its own; its card callback
+ * (Memcard_RemovedCallback, tmce/native/tmce_runtime.c) sets is_done there. The native CARD calls do not use work_area. */
+extern MemcardWork mu_tmce_memcard_work;
+#define stc_memcard_work (&mu_tmce_memcard_work)
+#else
 extern void *mu_tmce_ref_stc_memcard_work;
 #define stc_memcard_work ((MemcardWork *)((char *)mu_tmce_ref_stc_memcard_work + 0))
+#endif
 extern char mu_mx_gmMainLib_8045A6C0[] __asm__("gmMainLib_8045A6C0");
 static Memcard *stc_memcard = (void *)(mu_mx_gmMainLib_8045A6C0 + 0); // pointer to this data @ 0x804d3ee0
