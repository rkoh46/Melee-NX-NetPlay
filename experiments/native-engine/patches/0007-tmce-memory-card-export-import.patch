+/* Melee-NX-NetPlay (patches/0007): TM-CE's own card work block and its card callback (MexTK memcard.h), which marks the
+ * operation done for Memcard_Wait. The game's card state (lbcardnew.c) is no longer touched by TM-CE's card calls. */
+MemcardWork mu_tmce_memcard_work;
+void mu_tmce_card_complete(s32 chan, s32 result)
+{
+    (void) chan; (void) result;
+    mu_tmce_memcard_work.is_done = 1;
+}
