+// patches/net-0004: this side's build message, once per connection (a setting changed later applies from the next one, so
+// both sides always decide from the bytes they exchanged).
+void NetplayClient::QueueNxBuild() {
+  const auto& cfg = slippi::online::config();
+  if (!cfg.nx_build_message) { host::log("slippi: no build message (test: behaving as Slippi Dolphin)"); return; }
+  sent_no_pause_ = !cfg.direct_pause;
+  for (int i = 0; i < 2; ++i) sent_port_colour_[i] = (int8_t)std::clamp(cfg.port_colour[i], -1, 3);
+  auto p = std::make_unique<Packet>();
+  *p << (uint8_t)NP_MSG_NX_BUILD << (uint8_t)'N' << (uint8_t)'X' << (uint8_t)'B' << (uint8_t)1 << player_idx_
+     << (uint8_t)(1 | (sent_no_pause_ ? 2 : 0));
+  const uint32_t shield = cfg.shield_online;
+  if (shield & 0x1000000u) *p << (uint8_t)1 << (uint8_t)(shield >> 16) << (uint8_t)(shield >> 8) << (uint8_t)shield;
+  else *p << (uint8_t)0;
+  *p << (uint8_t)(sent_port_colour_[0] + 1) << (uint8_t)(sent_port_colour_[1] + 1);
+  { std::lock_guard<std::mutex> lk(async_mutex_); async_queue_.push_front(std::move(p)); }
+  host::log("slippi: build message queued (Direct pause %s, shield colour %s%06X, port colours %d/%d)", sent_no_pause_ ? "off" : "on",
+            (shield & 0x1000000u) ? "" : "none ", shield & 0xFFFFFFu, sent_port_colour_[0], sent_port_colour_[1]);
+}
+bool NetplayClient::PauseOff() const {
+  std::lock_guard<std::mutex> lk(nx_mutex_);
+  if (remote_player_count_ == 0) return false;
+  bool off = sent_no_pause_;
+  int seen = 0;
+  for (int port = 0; port < 4; ++port) {
+    if (port == player_idx_) continue;
+    if (!remote_nx_[port].received) continue;
+    if (!remote_nx_[port].pause_rule) return false;
+    off = off || remote_nx_[port].no_pause;
+    ++seen;
+  }
+  return seen == remote_player_count_ && off;     // a remote player without the message (Slippi Dolphin): Slippi's rule
+}
+bool NetplayClient::PortColours(int8_t mine[2], int8_t theirs[2]) const {
+  std::lock_guard<std::mutex> lk(nx_mutex_);
+  if (remote_player_count_ != 1) return false;
+  const uint8_t other = player_idx_ == 0 ? 1 : 0;
+  if (!remote_nx_[other].received) return false;
+  for (int i = 0; i < 2; ++i) { mine[i] = sent_port_colour_[i]; theirs[i] = remote_nx_[other].port_colour[i]; }
+  return true;
+}
