+// patches/net-0004: online 1v1 port colours (melee-unlocked's rule): each player shows in their first choice; a colour both
+// picked goes to one of them by the match's agreed random offset and the other gets their second choice; a player with no
+// choice keeps their port's colour. Both builds know both choices (the build message), so both draw the same. Display only.
+void update_port_colours(uint32_t rng_offset) {
+  int8_t mine[2], theirs[2];
+  const int me = g_local_player_index;
+  if (!g_netplay || !g_matchmaking || g_matchmaking->RemotePlayerCount() != 1 || me > 1 || !g_netplay->PortColours(mine, theirs) ||
+      (mine[0] < 0 && theirs[0] < 0)) { g_port_colour_bits.store(0, std::memory_order_relaxed); return; }
+  const int8_t* pref[2] = {me == 0 ? mine : theirs, me == 0 ? theirs : mine};
+  int colour[2] = {-1, -1};
+  bool taken[4] = {};
+  for (int p = 0; p < 2; ++p) if (pref[p][0] < 0) { colour[p] = p; taken[p] = true; }
+  const int first = (int)((rng_offset >> 3) & 1u);
+  for (int k = 0; k < 2; ++k) {
+    const int p = k == 0 ? first : 1 - first;
+    if (colour[p] >= 0) continue;
+    for (const int c : {(int)pref[p][0], (int)pref[p][1], p}) if (c >= 0 && c < 4 && !taken[c]) { colour[p] = c; break; }
+    for (int c = 0; colour[p] < 0 && c < 4; ++c) if (!taken[c]) colour[p] = c;
+    taken[colour[p]] = true;
+  }
+  const uint32_t bits = ((uint32_t)colour[0] | ((uint32_t)colour[1] << 2)) << 28;
+  if (g_port_colour_bits.exchange(bits, std::memory_order_relaxed) != bits)
+    host::log("slippi: port colours P1 %d, P2 %d (0 red, 1 blue, 2 yellow, 3 green)", colour[0], colour[1]);
+}
