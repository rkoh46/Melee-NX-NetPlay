+bool NetplayClient::SendPickPreview(const uint8_t* wire, size_t size) {
+  if (GetSlippiConnectStatus() != ConnectStatus::CONNECTED || !slippi::online::config().pick_previews) return false;
+  bool any = false;
+  {
+    std::lock_guard<std::mutex> lk(nx_mutex_);
+    for (int port = 0; port < 4; ++port) if (port != player_idx_ && remote_nx_[port].received && remote_nx_[port].pick_previews) any = true;
+  }
+  if (!any) return false;
+  auto p = std::make_unique<Packet>();
+  *p << (uint8_t)NP_MSG_NX_PICK << player_idx_;
+  for (size_t i = 0; i < size; ++i) *p << wire[i];
+  SendAsync(std::move(p));
+  return true;
+}
+bool NetplayClient::RemotePickPreview(uint8_t port, std::vector<uint8_t>* wire) const {
+  std::lock_guard<std::mutex> lk(nx_mutex_);
+  if (port > 3 || remote_pick_[port].empty()) return false;
+  *wire = remote_pick_[port];
+  return true;
