+// patches/net-0005. Play while you search (melee-unlocked's kept search, its slippi_online.cpp search_away): the player left the
+// character select with an Unranked search running and plays offline meanwhile. While the search is kept the game's cleanup
+// commands (the main menu sends one when it comes up) leave it running; the game itself sees no session (it asks for nothing
+// online off the online screens), so whatever is played meanwhile is plain offline play. The warm-up room (melee-unlocked's
+// warmup_park: Direct or Teams, connected, not locked in) keeps the connection the same way.
+struct SearchInfo {
+  int state = -1;                // Matchmaking::ProcessState (0 idle .. 4 connected, 5 error), -1 offline
+  int mode = -1;                 // the last search's mode (1 Unranked, 2 Direct, 3 Teams, 4 Party)
+  bool locked = false;           // this player's selections are locked in
+  int character = -1, color = 0; // the locked-in fighter (external id) and costume
+  bool kept = false;
+  bool remote_ready = false;     // connected and every other player locked in (the warm-up room goes back then)
+  uint32_t elapsed_ms = 0;       // since the search started
+  std::string error, opponent;
+};
+SearchInfo search_info();
+void keep_search(bool kept);
+// A kept search that cannot go on (it stopped, or the player could not be brought back): the connection is cleaned up.
+void end_kept_search(const char* why);
+// The last online frame's time sync and wait: skip 0 none, 1 waiting for the other player's inputs, 2 time sync halt; advanced:
+// the frame was advanced for time sync; offset_us: the time sync offset as last measured (above 0: this side is ahead).
+void frame_trace(int* skip, bool* advanced, int32_t* offset_us);
 
