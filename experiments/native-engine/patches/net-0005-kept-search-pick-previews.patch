+// patches/net-0005: live pick previews (melee-unlocked's command 0xED, port/runtime/abi/mu_pick_preview.h, which the game's
+// online character select uses: op 0 sends this player's pick every frame, op 1 reads the others'). Only between Melee-NX-NetPlay
+// builds (NP_MSG_NX_PICK, to a peer whose build message says it reads them); against Slippi Dolphin or melee-unlocked nothing
+// is sent and every slot reads empty. Display only: match setup is still the 0x82 selections.
+void handle_pick_preview(const uint8_t* payload, uint32_t size, std::vector<uint8_t>& q) {
+  q.clear();
+  if (size < 1) return;
+  if (payload[0] == MU_PICK_PREVIEW_OP_SEND) {
+    if (size != 1 + MU_PICK_PREVIEW_WIRE || !g_netplay || !g_config.pick_previews) return;
+    MuPickPreview check;
+    if (!mu_pick_preview_decode(payload + 1, MU_PICK_PREVIEW_WIRE, &check)) return;
+    // melee-unlocked's sender rule: on change, at most one per MU_PICK_PREVIEW_INTERVAL frames, at once on lock-in.
+    static MuPickPreviewSender sender;
+    if (!g_pick_sent) { sender = MuPickPreviewSender{}; g_pick_sent = true; }
+    if (!mu_pick_preview_due(&sender, payload + 1, host::retrace_count(), check.locked && !sender.last[MU_PICK_PREVIEW_WIRE - 1])) return;
+    // Nobody reads it yet (no build message from a reader so far): forget it, so the same pick goes out once one does.
+    if (!g_netplay->SendPickPreview(payload + 1, MU_PICK_PREVIEW_WIRE)) sender = MuPickPreviewSender{};
+    return;
+  }
+  if (payload[0] != MU_PICK_PREVIEW_OP_READ) return;
+  MuPickPreviewSlot slots[MU_PICK_PREVIEW_REMOTES] = {};
+  if (g_netplay && g_config.pick_previews && g_netplay->GetSlippiConnectStatus() == NetplayClient::ConnectStatus::CONNECTED) {
+    int index = 0;
+    const uint8_t local = g_netplay->LocalPlayerPort();
+    for (uint8_t port = 0; port < 4 && index < MU_PICK_PREVIEW_REMOTES; ++port) {
+      if (port == local) continue;
+      std::vector<uint8_t> wire;
+      if (g_netplay->RemotePickPreview(port, &wire) && mu_pick_preview_decode(wire.data(), wire.size(), &slots[index].pick)) {
+        slots[index].valid = 1; slots[index].port = port;
+      }
+      ++index;
+    }
+  }
+  q.resize(MU_PICK_PREVIEW_REPLY);
+  q.resize(mu_pick_preview_reply_encode(slots, q.data(), q.size()));
+}
