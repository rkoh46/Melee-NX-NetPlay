     if (frame == 1) for (int i = 1; i <= delay; ++i) g_netplay->SendSlippiPad(std::make_unique<Pad>(i));
-    g_netplay->SendSlippiPad(std::make_unique<Pad>(frame + delay, finalized, finalized_checksum, inputs));
+    // patches/net-0009, tests only: MELEE_NET_TEST_CHECKSUM=FRAME:low|high sends the other side wrong checksums for the 30 finalized
+    // frames from FRAME on (low: the low half off by 5, the game's "DESYNC DETECTED"; high: only the high half, its "Desync Risk").
+    // Thirty, because a pad carries only the newest finalized frame's checksum and the other side compares the newest it has.
+    static int test_frame = -1; static bool test_low = true;
+    static const bool test_parsed = [] {
+      if (const char* v = std::getenv("MELEE_NET_TEST_CHECKSUM")) { test_frame = std::atoi(v); test_low = std::strstr(v, "high") == nullptr; }
+      return true;
+    }();
+    (void)test_parsed;
+    uint32_t sent_checksum = finalized_checksum;
+    if (test_frame > 0 && finalized >= test_frame && finalized < test_frame + 30 && finalized_checksum) {
+      sent_checksum = test_low ? ((finalized_checksum & 0xFFFF0000u) | ((finalized_checksum + 5) & 0xFFFFu)) : (finalized_checksum ^ 0x00010000u);
+      host::log("slippi: test aid: frame %d's checksum sent as %08X (ours %08X, %s half)", finalized, sent_checksum, finalized_checksum, test_low ? "low" : "high");
+    }
+    g_netplay->SendSlippiPad(std::make_unique<Pad>(frame + delay, finalized, sent_checksum, inputs));
